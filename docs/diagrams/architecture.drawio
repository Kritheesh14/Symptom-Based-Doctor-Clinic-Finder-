    <mxCell id="title" value="System architecture" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="900" height="30" as="geometry"/></mxCell>
    <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;hr&gt;Next.js pages (React, Tailwind)&lt;br&gt;patient + admin UI" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="200" height="80" as="geometry"/></mxCell>
    <mxCell id="proxy" value="&lt;b&gt;proxy.ts (page guard)&lt;/b&gt;&lt;hr&gt;JWT cookie check (jose)&lt;br&gt;redirects by role" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="200" height="80" as="geometry"/></mxCell>
    <mxCell id="api" value="&lt;b&gt;Route Handlers /api/*&lt;/b&gt;&lt;hr&gt;zod validation&lt;br&gt;requireRole() on every route&lt;br&gt;error mapping (SQLSTATE -&gt; HTTP)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="60" width="240" height="110" as="geometry"/></mxCell>
