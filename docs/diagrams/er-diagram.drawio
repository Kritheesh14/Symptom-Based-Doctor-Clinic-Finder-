    <mxCell id="title" value="Symptom-Based Doctor &amp; Clinic Finder - ER Diagram (relational part)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="900" height="30" as="geometry"/></mxCell>
    <mxCell id="P" value="&lt;b&gt;PATIENTS&lt;/b&gt;&lt;hr&gt;&lt;u&gt;patient_id&lt;/u&gt; (PK)&lt;br&gt;name [NOT NULL]&lt;br&gt;age [CHECK 1..129]&lt;br&gt;contact_info [CHECK format]&lt;br&gt;email [UNIQUE, NOT NULL]&lt;br&gt;password_hash [bcrypt]&lt;br&gt;created_at [DEFAULT now]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="200" height="160" as="geometry"/></mxCell>
    <mxCell id="ADM" value="&lt;b&gt;ADMINS&lt;/b&gt;&lt;hr&gt;&lt;u&gt;admin_id&lt;/u&gt; (PK)&lt;br&gt;name [NOT NULL]&lt;br&gt;email [UNIQUE, NOT NULL]&lt;br&gt;password_hash [bcrypt]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="40" width="200" height="96" as="geometry"/></mxCell>
    <mxCell id="admnote" value="Admins manage doctors, clinics and specialities (role-based access in the app; no FK)." style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="900" y="142" width="200" height="40" as="geometry"/></mxCell>
    <mxCell id="A" value="&lt;b&gt;APPOINTMENTS&lt;/b&gt;&lt;hr&gt;&lt;u&gt;appointment_id&lt;/u&gt; (PK)&lt;br&gt;appointment_time [NOT NULL]&lt;br&gt;status [CHECK enum]&lt;br&gt;created_at&lt;br&gt;patient_id (FK)&lt;br&gt;doctor_id, clinic_id (composite FK -&gt; works_at)&lt;br&gt;UNIQUE(doctor_id, time) where scheduled" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="200" height="150" as="geometry"/></mxCell>
