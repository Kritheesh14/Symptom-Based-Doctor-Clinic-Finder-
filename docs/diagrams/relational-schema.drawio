<mxfile host="app.diagrams.net"><diagram name="Relational Schema" id="relational-schema"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="Symptom-Based Doctor &amp; Clinic Finder - Relational Schema (arrow = foreign key -&gt; referenced table)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="900" height="30" as="geometry"/></mxCell>
    <mxCell id="P" value="&lt;b&gt;patients&lt;/b&gt;&lt;hr&gt;&lt;u&gt;patient_id&lt;/u&gt; SERIAL (PK)&lt;br&gt;name VARCHAR(100) NOT NULL&lt;br&gt;age INT CHECK (0 &amp;lt; age &amp;lt; 130)&lt;br&gt;contact_info VARCHAR(20) CHECK format&lt;br&gt;email VARCHAR(150) UNIQUE NOT NULL&lt;br&gt;password_hash TEXT NOT NULL&lt;br&gt;created_at TIMESTAMP DEFAULT now" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="260" height="160" as="geometry"/></mxCell>
    <mxCell id="ADM" value="&lt;b&gt;admins&lt;/b&gt;&lt;hr&gt;&lt;u&gt;admin_id&lt;/u&gt; SERIAL (PK)&lt;br&gt;name VARCHAR(100) NOT NULL&lt;br&gt;email VARCHAR(150) UNIQUE NOT NULL&lt;br&gt;password_hash TEXT NOT NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="40" width="260" height="96" as="geometry"/></mxCell>
    <mxCell id="A" value="&lt;b&gt;appointments&lt;/b&gt;&lt;hr&gt;&lt;u&gt;appointment_id&lt;/u&gt; SERIAL (PK)&lt;br&gt;patient_id INT (FK) NOT NULL&lt;br&gt;doctor_id INT NOT NULL&lt;br&gt;clinic_id INT NOT NULL&lt;br&gt;appointment_time TIMESTAMP NOT NULL&lt;br&gt;status VARCHAR(20) CHECK enum DEFAULT scheduled&lt;br&gt;created_at TIMESTAMP DEFAULT now&lt;br&gt;FK (doctor_id, clinic_id) -&gt; works_at&lt;br&gt;UNIQUE INDEX (doctor_id, appointment_time) WHERE scheduled" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="260" height="172" as="geometry"/></mxCell>
    <mxCell id="C" value="&lt;b&gt;clinics&lt;/b&gt;&lt;hr&gt;&lt;u&gt;clinic_id&lt;/u&gt; SERIAL (PK)&lt;br&gt;clinic_name VARCHAR(150) NOT NULL&lt;br&gt;address VARCHAR(255) NOT NULL&lt;br&gt;phone VARCHAR(20) CHECK format&lt;br&gt;search_vector tsvector (generated)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="340" width="260" height="96" as="geometry"/></mxCell>
    <mxCell id="W" value="&lt;b&gt;works_at&lt;/b&gt;&lt;hr&gt;&lt;u&gt;doctor_id&lt;/u&gt; INT (PK, FK)&lt;br&gt;&lt;u&gt;clinic_id&lt;/u&gt; INT (PK, FK)&lt;br&gt;since_date DATE DEFAULT today" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="495" width="260" height="84" as="geometry"/></mxCell>
    <mxCell id="Rx" value="&lt;b&gt;prescriptions&lt;/b&gt;&lt;hr&gt;&lt;u&gt;prescription_id&lt;/u&gt; SERIAL (PK)&lt;br&gt;appointment_id INT (FK) UNIQUE NOT NULL&lt;br&gt;medicine_details TEXT NOT NULL&lt;br&gt;notes TEXT&lt;br&gt;issued_at TIMESTAMP DEFAULT now" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="260" height="112" as="geometry"/></mxCell>
    <mxCell id="Dr" value="&lt;b&gt;doctors&lt;/b&gt;&lt;hr&gt;&lt;u&gt;doctor_id&lt;/u&gt; SERIAL (PK)&lt;br&gt;name VARCHAR(100) NOT NULL&lt;br&gt;years_experience INT CHECK (0..60)&lt;br&gt;availability_status VARCHAR(20) CHECK enum&lt;br&gt;speciality_id INT (FK) NOT NULL&lt;br&gt;search_vector tsvector (generated)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="650" width="260" height="126" as="geometry"/></mxCell>
    <mxCell id="S" value="&lt;b&gt;specialities&lt;/b&gt;&lt;hr&gt;&lt;u&gt;speciality_id&lt;/u&gt; SERIAL (PK)&lt;br&gt;speciality_name VARCHAR(100) UNIQUE NOT NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="680" width="260" height="66" as="geometry"/></mxCell>
    <mxCell id="e1" value="patient_id (CASCADE)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="A" target="P"><mxGeometry x="-0.3" relative="1" as="geometry"/></mxCell>
    <mxCell id="e2" value="(doctor_id, clinic_id)  RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="A" target="W"><mxGeometry x="-0.4" relative="1" as="geometry"/></mxCell>
    <mxCell id="e3" value="appointment_id (CASCADE)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="Rx" target="A"><mxGeometry x="-0.3" relative="1" as="geometry"/></mxCell>
    <mxCell id="e4" value="clinic_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="W" target="C"><mxGeometry x="-0.3" relative="1" as="geometry"/></mxCell>
    <mxCell id="e5" value="doctor_id (CASCADE)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="W" target="Dr"><mxGeometry x="-0.3" relative="1" as="geometry"/></mxCell>
    <mxCell id="e6" value="speciality_id (RESTRICT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="Dr" target="S"><mxGeometry x="-0.3" relative="1" as="geometry"/></mxCell>
    <mxCell id="legend" value="Blue = relational tables. appointments reference works_at (not doctors/clinics directly), so a doctor can only be booked at a clinic where they work. Symptom vectors are in Qdrant (see qdrant-model)." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1100" height="30" as="geometry"/></mxCell>
  </root>
</mxGraphModel></diagram></mxfile>
