<mxfile host="app.diagrams.net"><diagram name="Qdrant Model" id="qdrant-model"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="Vector data model (Qdrant) - collections, payloads, indexes and links to PostgreSQL" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="900" height="30" as="geometry"/></mxCell>
    <mxCell id="cases" value="&lt;b&gt;Collection: symptom_cases&lt;/b&gt;&lt;hr&gt;vector: 384 floats (all-MiniLM-L6-v2), distance = Cosine&lt;br&gt;point id: UUID (seed: sha1 of text; confirmed: query id)&lt;br&gt;&lt;b&gt;payload&lt;/b&gt;&lt;br&gt;text (string)&lt;br&gt;speciality_id (int)  [payload index]&lt;br&gt;speciality_name (string)&lt;br&gt;source: &quot;seed&quot; | &quot;confirmed&quot;  [payload index]&lt;br&gt;created_at (ISO timestamp)&lt;br&gt;appointment_id (int, only for confirmed)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="330" height="230" as="geometry"/></mxCell>
    <mxCell id="queries" value="&lt;b&gt;Collection: patient_queries&lt;/b&gt;&lt;hr&gt;vector: 384 floats, distance = Cosine&lt;br&gt;point id: UUID (returned to the browser as queryId)&lt;br&gt;&lt;b&gt;payload&lt;/b&gt;&lt;br&gt;patient_id (int)  [payload index]&lt;br&gt;text (string)&lt;br&gt;speciality_id (int, predicted)  [payload index]&lt;br&gt;speciality_name, confidence, low_confidence&lt;br&gt;appointment_id (int, set on booking)  [payload index]&lt;br&gt;created_at (ISO timestamp)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="60" width="330" height="230" as="geometry"/></mxCell>
    <mxCell id="pg" value="&lt;b&gt;PostgreSQL (source of truth)&lt;/b&gt;&lt;hr&gt;specialities.speciality_id  &amp;lt;-  payload.speciality_id&lt;br&gt;patients.patient_id  &amp;lt;-  payload.patient_id&lt;br&gt;appointments.appointment_id  &amp;lt;-  payload.appointment_id&lt;br&gt;Links are logical (no FK across databases)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="420" width="330" height="110" as="geometry"/></mxCell>
    <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cases" target="pg"><mxGeometry x="-0.55" relative="1" as="geometry"/></mxCell>
    <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="queries" target="pg"><mxGeometry x="-0.55" relative="1" as="geometry"/></mxCell>
    <mxCell id="e3" value="completed visit: copy vector + text, label = doctor&#x27;s speciality, source = confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="queries" target="cases"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell>
    <mxCell id="flow" value="Retrieval: embed(text) -&gt; top-K (default 5) nearest points in symptom_cases -&gt; score-weighted vote per speciality_id -&gt; winner = recommended speciality; confidence = winner share of total score; below RECOMMEND_MIN_CONFIDENCE (0.4) the UI shows alternatives and suggests General Medicine." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="850" height="60" as="geometry"/></mxCell>
  </root>
</mxGraphModel></diagram></mxfile>
