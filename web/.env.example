# Copy to .env.local (never commit .env.local). All values below are placeholders.

# PostgreSQL connection string (user/password/host/db)
DATABASE_URL=postgresql://symptom:CHANGE_ME@localhost:5432/symptom_finder

# Qdrant (Docker: http://localhost:6333 ; Qdrant Cloud: your cluster URL + API key)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Session signing key: at least 32 random characters.  Generate with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARS

# Retrieval tuning
RECOMMEND_TOP_K=5
RECOMMEND_MIN_CONFIDENCE=0.4
